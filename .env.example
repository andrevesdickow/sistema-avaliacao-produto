# URL do projeto Supabase (Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key (Project Settings > API > service_role secret)
# ATENÇÃO: nunca exponha esta chave no cliente. Ela ignora as políticas de RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Segredo usado para assinar o cookie de sessão com HMAC-SHA256.
# Gere um valor longo e aleatório, por exemplo: openssl rand -base64 32
# Obrigatório em produção. Em desenvolvimento, sem esta variável o app usa um
# fallback local inseguro apenas para não travar o `npm run dev`.
SESSION_SECRET=your-long-random-session-secret

# Chave da OpenAI usada pelo agente de resumo por IA (Mastra + openai/gpt-4o-mini).
OPENAI_API_KEY=your-openai-api-key
